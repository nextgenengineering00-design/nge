{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ngebuild-next",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "routes": [
    {
      "pattern": "ngebuild.com",
      "custom_domain": true
    },
    {
      "pattern": "www.ngebuild.com/*",
      "zone_name": "ngebuild.com"
    }
  ],
  "workers_dev": true,
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://yryfrpooocpwnfilfsho.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_qP9UqdOsy-2rUN7ek4DrzQ_19sBGZIx"
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  }
}
